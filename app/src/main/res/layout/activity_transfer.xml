<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/transferRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    tools:context=".ui.TransferActivity">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="48dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTransferHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="File Transfer"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?android:textColorPrimary" />

        <TextView
            android:id="@+id/tvTransferSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Connecting via high-speed P2P link..."
            android:textSize="13sp"
            android:textColor="?android:textColorSecondary" />
    </LinearLayout>

    <!-- Center Card: File Details & Animated Progress -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTransferMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:strokeWidth="1dp"
        app:strokeColor="#CBD5E1"
        app:layout_constraintBottom_toTopOf="@id/btnCancelTransfer"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintVertical_bias="0.35">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- File Icon Avatar -->
            <TextView
                android:id="@+id/tvFileIcon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_scanner_reticle"
                android:gravity="center"
                android:text="📄"
                android:textSize="36sp" />

            <!-- File Name -->
            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="sample_video.mp4"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?android:textColorPrimary"
                android:ellipsize="middle"
                android:singleLine="true" />

            <!-- File Transferred Bytes vs Total -->
            <TextView
                android:id="@+id/tvBytesTransferred"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0 MB / 0 MB"
                android:textSize="13sp"
                android:textColor="?android:textColorSecondary" />

            <!-- Progress % Display -->
            <TextView
                android:id="@+id/tvPercentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="0%"
                android:textSize="44sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />

            <!-- Linear Smooth Progress Indicator -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="12dp"
                android:progress="0"
                app:indicatorColor="@color/primary"
                app:trackColor="#E2E8F0"
                app:trackCornerRadius="6dp" />

            <!-- Real-time Speed & ETA Metrics Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Speed Chip -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ -- MB/s"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:chipBackgroundColor="#EEF2FF"
                    app:chipStrokeColor="@color/primary"
                    app:chipStrokeWidth="1dp" />

                <!-- ETA Chip -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="⏳ Calculating..."
                    android:textSize="13sp"
                    app:chipBackgroundColor="#F8FAFC"
                    app:chipStrokeColor="#CBD5E1"
                    app:chipStrokeWidth="1dp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelTransfer"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="36dp"
        android:text="Cancel Transfer"
        android:textAllCaps="false"
        android:textColor="@color/error"
        android:textSize="16sp"
        app:cornerRadius="16dp"
        app:strokeColor="@color/error"
        app:strokeWidth="1.5dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
