<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Anyshare" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowAnimationStyle">@style/AnyshareWindowAnimation</item>
    </style>

    <style name="Theme.Anyshare" parent="Base.Theme.Anyshare" />

    <style name="AnyshareWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in_tab</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out_tab</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in_tab</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out_tab</item>
    </style>
</resources>